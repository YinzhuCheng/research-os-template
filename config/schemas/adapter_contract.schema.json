{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-desktop.local/schemas/adapter_contract.schema.json",
  "title": "Research OS Adapter Contract",
  "type": "object",
  "required": [
    "adapter_id",
    "capabilities",
    "input_schema",
    "output_schema",
    "side_effects",
    "resource_cost",
    "privacy_class",
    "human_confirmation_required",
    "replay_support",
    "failure_modes",
    "license_constraints",
    "safety_review_required"
  ],
  "properties": {
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "resource_cost": { "type": "string" },
    "privacy_class": { "type": "string" },
    "human_confirmation_required": { "type": "boolean" },
    "replay_support": { "type": "string" },
    "failure_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "license_constraints": { "type": "string" },
    "safety_review_required": { "type": "boolean" }
  }
}
