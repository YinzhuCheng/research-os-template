{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/domain_profile.schema.json",
  "title": "Research OS Domain Profile",
  "type": "object",
  "required": [
    "domain_id",
    "display_name",
    "research_family",
    "classification_sources",
    "activation",
    "paradigms",
    "artifact_types",
    "kernel_bindings",
    "quality_gates",
    "status_lifecycle",
    "harness_boundaries",
    "source_basis"
  ],
  "properties": {
    "domain_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "research_family": { "type": "string", "minLength": 1 },
    "classification_sources": { "type": "array", "minItems": 1 },
    "activation": { "type": "object" },
    "paradigms": { "type": "array", "minItems": 1 },
    "artifact_types": { "type": "array", "minItems": 1 },
    "kernel_bindings": {
      "type": "object",
      "required": [
        "candidate",
        "evaluator_contract",
        "evaluation_result",
        "belief_state",
        "search_trace",
        "negative_result",
        "next_action_policy",
        "human_judgment_gate"
      ],
      "properties": {
        "candidate": { "type": "object" },
        "evaluator_contract": { "type": "object" },
        "evaluation_result": { "type": "object" },
        "belief_state": { "type": "object" },
        "search_trace": { "type": "object" },
        "negative_result": { "type": "object" },
        "next_action_policy": { "type": "object" },
        "human_judgment_gate": { "type": "object" },
        "computation_checklist_required": { "type": "boolean" }
      }
    },
    "quality_gates": { "type": "array", "minItems": 1 },
    "status_lifecycle": { "type": "object" },
    "harness_boundaries": { "type": "object" },
    "source_basis": { "type": "array", "minItems": 1 }
  }
}
