{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/copilot_questions.schema.json",
  "title": "Research OS Copilot Targeted Questions",
  "type": "object",
  "required": [
    "schema_version",
    "question_packet_id",
    "session_id",
    "created_at",
    "research_type",
    "questions",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "question_packet_id": { "type": "string", "pattern": "^QPACK-[0-9A-Za-z_-]+$" },
    "session_id": { "type": "string" },
    "created_at": { "type": "string" },
    "research_type": {
      "type": "string",
      "enum": ["theory", "experiment", "theory_and_experiment", "engineering_system", "survey", "unclear"]
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "question",
          "reason_for_asking",
          "recommended_answer",
          "options",
          "free_text_other",
          "plan_impact"
        ],
        "properties": {
          "question_id": { "type": "string", "pattern": "^Q-[0-9]{2}$" },
          "question": { "type": "string" },
          "reason_for_asking": { "type": "string" },
          "recommended_answer": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "description"],
              "properties": {
                "label": { "type": "string" },
                "description": { "type": "string" },
                "recommended": { "type": "boolean" }
              }
            }
          },
          "free_text_other": {
            "type": "object",
            "required": ["enabled", "label"],
            "properties": {
              "enabled": { "type": "boolean", "const": true },
              "label": { "type": "string" }
            }
          },
          "plan_impact": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready_for_human", "answered", "superseded", "blocked"]
    }
  }
}
