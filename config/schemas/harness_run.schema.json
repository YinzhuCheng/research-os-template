{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/harness_run.schema.json",
  "title": "Research OS Harness Run",
  "type": "object",
  "required": [
    "harness_run_id",
    "work_order_id",
    "created_at",
    "command_or_tool",
    "status",
    "inputs",
    "outputs",
    "terminal_state",
    "privacy_level"
  ],
  "properties": {
    "harness_run_id": { "type": "string", "pattern": "^HR-[0-9]{4}$" },
    "work_order_id": { "type": "string", "pattern": "^WO-[0-9]{4}$" },
    "created_at": { "type": "string" },
    "command_or_tool": { "type": "string" },
    "status": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "terminal_state": {
      "type": "string",
      "enum": ["planned", "succeeded", "failed", "timed_out", "cancelled", "partial", "blocked", "unverified"]
    },
    "replay": { "type": "object" },
    "monitoring": { "type": "object" },
    "privacy_level": { "type": "string" },
    "errors": { "type": "array" },
    "residual_risks": { "type": "array" }
  }
}
