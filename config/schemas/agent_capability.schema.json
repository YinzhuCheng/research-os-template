{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/agent_capability.schema.json",
  "title": "Research OS Agent Capability Registry",
  "type": "object",
  "required": [
    "domain_id",
    "agents"
  ],
  "properties": {
    "domain_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "role",
          "inputs",
          "outputs",
          "allowed_paths",
          "forbidden_paths",
          "resource_policy",
          "network_policy",
          "external_write_policy",
          "public_output_policy"
        ],
        "properties": {
          "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "role": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array" },
          "outputs": { "type": "array" },
          "allowed_paths": { "type": "array" },
          "forbidden_paths": { "type": "array" },
          "resource_policy": { "type": "object" },
          "network_policy": { "type": "string" },
          "external_write_policy": { "type": "string" },
          "public_output_policy": { "type": "string" }
        }
      }
    }
  }
}
