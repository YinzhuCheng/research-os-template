{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/copilot_answers.schema.json",
  "title": "Research OS Copilot Question Answers",
  "type": "object",
  "required": [
    "schema_version",
    "answers_packet_id",
    "session_id",
    "question_packet_id",
    "created_at",
    "answers",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "answers_packet_id": { "type": "string", "pattern": "^ANS-[0-9A-Za-z_-]+$" },
    "session_id": { "type": "string" },
    "question_packet_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "answers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question_id", "selected_option", "free_text_other"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^Q-[0-9]{2}$" },
          "selected_option": { "type": "string" },
          "free_text_other": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["answers_received", "superseded", "blocked"]
    }
  }
}
