{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/copilot_initialization_report.schema.json",
  "title": "Research OS Copilot Initialization Report",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "session_id",
    "created_at",
    "research_type",
    "motivation",
    "expected_goals",
    "contribution_claims",
    "related_work_map",
    "reference_links",
    "download_script",
    "theory_track",
    "experiment_track",
    "minimum_validation",
    "repository_resource_links",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "report_id": { "type": "string", "pattern": "^INIT-[0-9A-Za-z_-]+$" },
    "session_id": { "type": "string" },
    "created_at": { "type": "string" },
    "research_type": {
      "type": "string",
      "enum": ["theory", "experiment", "theory_and_experiment", "engineering_system", "survey", "unclear"]
    },
    "motivation": { "type": "string" },
    "expected_goals": { "type": "array", "items": { "type": "string" } },
    "contribution_claims": { "type": "array", "items": { "type": "string" } },
    "related_work_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work", "shortcoming", "relationship_to_this_research"],
        "properties": {
          "work": { "type": "string" },
          "shortcoming": { "type": "string" },
          "relationship_to_this_research": { "type": "string" },
          "link": { "type": ["string", "null"] }
        }
      }
    },
    "reference_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "access_hint", "download_policy"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "doi": { "type": ["string", "null"] },
          "access_hint": { "type": "string" },
          "download_policy": {
            "type": "string",
            "enum": ["open_access_attempt", "landing_page_only", "human_download_required"]
          }
        }
      }
    },
    "download_script": {
      "type": "object",
      "required": ["path", "policy"],
      "properties": {
        "path": { "type": "string" },
        "policy": { "type": "string" }
      }
    },
    "theory_track": {
      "type": "object",
      "required": ["enabled", "framework", "key_definitions", "candidate_theorems", "proof_or_validation_notes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "framework": { "type": "string" },
        "key_definitions": { "type": "array", "items": { "type": "string" } },
        "candidate_theorems": { "type": "array", "items": { "type": "string" } },
        "proof_or_validation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "experiment_track": {
      "type": "object",
      "required": ["enabled", "experiment_plan", "budget_needed_from_researcher", "metrics", "stopping_rules"],
      "properties": {
        "enabled": { "type": "boolean" },
        "experiment_plan": { "type": "array", "items": { "type": "string" } },
        "budget_needed_from_researcher": { "type": "boolean" },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "stopping_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "minimum_validation": {
      "type": "object",
      "required": ["required", "plan", "budget_status"],
      "properties": {
        "required": { "type": "boolean" },
        "plan": { "type": "array", "items": { "type": "string" } },
        "budget_status": {
          "type": "string",
          "enum": ["not_applicable", "needs_researcher_budget", "budget_recorded"]
        }
      }
    },
    "repository_resource_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "path", "purpose"],
        "properties": {
          "label": { "type": "string" },
          "path": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_human_review", "evidence_linked", "ready_for_work_order", "blocked"]
    }
  }
}
