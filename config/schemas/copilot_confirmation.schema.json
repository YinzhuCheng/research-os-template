{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/copilot_confirmation.schema.json",
  "title": "Research OS Copilot Next Action Confirmation",
  "type": "object",
  "required": [
    "schema_version",
    "confirmation_id",
    "session_id",
    "created_at",
    "next_action",
    "confirmed",
    "requires_work_order",
    "notes",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "confirmation_id": { "type": "string", "pattern": "^CONF-[0-9A-Za-z_-]+$" },
    "session_id": { "type": "string" },
    "created_at": { "type": "string" },
    "next_action": { "type": "string" },
    "confirmed": { "type": "boolean" },
    "requires_work_order": { "type": "boolean" },
    "notes": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "changes_requested", "blocked"]
    }
  }
}
