{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-desktop.local/schemas/integration_registry.schema.json",
  "title": "Research OS Integration Registry",
  "type": "object",
  "required": ["registry_id", "updated_at", "default_policy", "components"],
  "properties": {
    "registry_id": { "type": "string", "pattern": "^INTEGRATIONS-[0-9]{4}$" },
    "updated_at": { "type": "string" },
    "default_policy": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
