{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os-template.local/schemas/copilot_intake.schema.json",
  "title": "Research OS Copilot Intake Packet",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "created_at",
    "free_text",
    "uploaded_files",
    "source_links",
    "privacy_default",
    "material_hashes",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "session_id": { "type": "string", "pattern": "^INTAKE-[0-9A-Za-z_-]+$" },
    "created_at": { "type": "string" },
    "free_text": { "type": "string" },
    "uploaded_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_id", "original_name", "size_bytes", "sha256", "storage_policy", "public_summary"],
        "properties": {
          "file_id": { "type": "string" },
          "original_name": { "type": "string" },
          "mime_type": { "type": ["string", "null"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "storage_policy": { "type": "string", "enum": ["private_runtime_only", "public_sanitized_summary_only"] },
          "public_summary": { "type": "string" },
          "private_runtime_path": { "type": ["string", "null"] }
        }
      }
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "declared_type", "fetch_authorized"],
        "properties": {
          "url": { "type": "string" },
          "declared_type": {
            "type": "string",
            "enum": ["chat_link", "paper_link", "repo_link", "demo_link", "note_link", "other"]
          },
          "fetch_authorized": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "privacy_default": { "type": "string", "enum": ["private"] },
    "material_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "saved",
        "pending_intake_analysis",
        "questions_ready",
        "answers_received",
        "initialization_pending_confirmation",
        "initialized",
        "blocked"
      ]
    }
  }
}
