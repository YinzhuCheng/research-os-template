# Private research material is intentionally excluded from public git history.
PRIVATE/**
!PRIVATE/
!PRIVATE/README.md
!PRIVATE/.gitkeep
!PRIVATE/secrets/
!PRIVATE/secrets/README.md
!PRIVATE/secrets/.gitkeep

# Local runtime artifacts.
.codex_state/
.cache/
__pycache__/
*.pyc
node_modules/
apps/research-os-desktop/src-tauri/target/
apps/research-os-desktop/dist/

# LaTeX/build outputs.
build/
dist/
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz

# Export bundles generated by scripts.
exports/
