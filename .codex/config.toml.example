# Copy to .codex/config.toml only in a trusted Research OS project.
# The template uses examples rather than active config so installing it cannot
# silently change the current Codex session.

sandbox_mode = "workspace-write"
approval_policy = "on-request"
approvals_reviewer = "user"
project_doc_max_bytes = 65536
project_doc_fallback_filenames = ["AGENTS.md"]

[sandbox_workspace_write]
writable_roots = ["."]

[[hooks.PreToolUse]]
matcher = "^Bash$|^shell_command$|^apply_patch$"

[[hooks.PreToolUse.hooks]]
type = "command"
command_windows = "python .codex/hooks/pre_tool_use_policy.py"
timeout = 30
statusMessage = "Checking Research OS policy"

[[hooks.PostToolUse]]
matcher = "^Bash$|^shell_command$|^apply_patch$"

[[hooks.PostToolUse.hooks]]
type = "command"
command_windows = "python .codex/hooks/post_tool_use_review.py"
timeout = 30
statusMessage = "Reviewing Research OS tool output"

[[hooks.Stop]]
matcher = ".*"

[[hooks.Stop.hooks]]
type = "command"
command_windows = "python .codex/hooks/stop_review.py"
timeout = 30
statusMessage = "Checking final Research OS state"
